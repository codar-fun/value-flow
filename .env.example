# loop-backend is now the data + auth backend. CC's /api/* routes proxy it
# server-side (no CORS) and store loop's OTP session in httpOnly cookies.
# Defaults to production; override for a local loop-backend.
LOOP_API_BASE=https://loop-api.sola.day/api

# Local multi-user testing only. The frontend enables these controls only when
# the loop backend is also local and each token was issued by that backend.
# Never set these against production or commit real tokens.
# LOOP_API_BASE=http://localhost:4000/api
# LOCAL_TEST_AUTH=true
# LOCAL_TEST_USER_A_LABEL=User A
# LOCAL_TEST_USER_A_ACCESS_TOKEN=local-backend-issued-access-token
# LOCAL_TEST_USER_B_LABEL=User B
# LOCAL_TEST_USER_B_ACCESS_TOKEN=local-backend-issued-access-token
# LOCAL_TEST_USER_C_LABEL=User C
# LOCAL_TEST_USER_C_ACCESS_TOKEN=local-backend-issued-access-token
# LOCAL_TEST_ACCESS_TOKEN_EXPIRES_IN=900

# 泡泡助手（assistant/draft）现在由 loop-backend 处理；这些变量在 loop 后端配置，
# CC 前端不再需要。保留仅作说明。
# BUBBLE_ASSISTANT_API_URL=
# BUBBLE_ASSISTANT_API_KEY=
# BUBBLE_ASSISTANT_MODEL=
# BUBBLE_ASSISTANT_SYSTEM_PROMPT=

# loop-backend is now the data + auth backend. CC's /api/* routes proxy it
# server-side (no CORS) and store loop's OTP session in httpOnly cookies.
# Defaults to production; override for a local loop-backend.
LOOP_API_BASE=https://loop-api.sola.day/api

# 泡泡助手（assistant/draft）现在由 loop-backend 处理；这些变量在 loop 后端配置，
# CC 前端不再需要。保留仅作说明。
# BUBBLE_ASSISTANT_API_URL=
# BUBBLE_ASSISTANT_API_KEY=
# BUBBLE_ASSISTANT_MODEL=
# BUBBLE_ASSISTANT_SYSTEM_PROMPT=

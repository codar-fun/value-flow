# Copy to .dev.vars for local Cloudflare/Vinext development.
LOOP_API_BASE=http://localhost:4000/api

# Enable only with a local loop-backend and real tokens issued by it.
LOCAL_TEST_AUTH=true
LOCAL_TEST_USER_A_LABEL=User A
LOCAL_TEST_USER_A_ACCESS_TOKEN=local-backend-issued-access-token
LOCAL_TEST_USER_B_LABEL=User B
LOCAL_TEST_USER_B_ACCESS_TOKEN=local-backend-issued-access-token
LOCAL_TEST_USER_C_LABEL=User C
LOCAL_TEST_USER_C_ACCESS_TOKEN=local-backend-issued-access-token
LOCAL_TEST_ACCESS_TOKEN_EXPIRES_IN=900
